{
  "name": "vibe-coder",
  "license": "(GPL-3.0-or-later AND CC-BY-4.0)",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:music-lab": "vite --open /music-lab/",
    "build": "vite build && vite-node tools/reportSize.ts",
    "check:types": "svelte-check --tsconfig tsconfig.json && tsc -p tsconfig.game.json && tsc -p tools/type-fixtures/tsconfig.positive.json",
    "lint": "eslint src tests tools/*.ts tools/art tools/music art vite.config.ts vitest.config.ts playwright.config.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run check:types && npm run lint && npm run format:check && npm run test:rules && npm run check:content && npm run check:release-content && npm run music:check-types && npm run music:validate && npm run music:check-pack && vite-node tools/notices.ts -- --check",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:game": "vitest run --config vitest.config.ts",
    "check:content": "vite-node tools/checkContent.ts && vite-node tools/art/export.ts -- --check",
    "test:browser": "playwright test",
    "art:export": "vite-node tools/art/export.ts",
    "art:check": "vite-node tools/art/export.ts -- --check",
    "check:release-content": "vite-node tools/checkReleaseContent.ts",
    "test:music": "vitest run --config vitest.music.config.ts",
    "music:types": "vite-node tools/music/generateTypes.ts",
    "music:check-types": "vite-node tools/music/generateTypes.ts -- --check && tsc -p tsconfig.music.json",
    "music:validate": "vite-node tools/music/validate.ts",
    "music:pack": "vite-node tools/music/buildPack.ts",
    "music:import": "vite-node tools/music/importMidi.ts && prettier --log-level warn --write \"music/patterns/**/*.json\"",
    "notices": "vite-node tools/notices.ts",
    "music:prompt": "vite-node tools/music/generatePrompt.ts",
    "music:check-pack": "vite-node tools/music/buildPack.ts -- --mode approved --check && vite-node tools/music/buildPack.ts -- --mode demo --check",
    "test:music-browser": "playwright test --config playwright.music.config.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "pixi.js": "^8.6.6",
    "svelte": "^5.19.0",
    "tonal": "^6.4.2",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.8",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vite-node": "^3.2.4",
    "vitest": "^3.0.2"
  }
}

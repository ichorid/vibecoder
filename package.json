{
  "name": "vibe-coder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:types": "svelte-check --tsconfig tsconfig.json && tsc -p tsconfig.game.json && tsc -p tools/type-fixtures/tsconfig.positive.json",
    "lint": "eslint src tests vite.config.ts vitest.config.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run check:types && npm run lint && npm run format:check && npm run test:rules",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:game": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "svelte": "^5.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  }
}

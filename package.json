{
  "name": "vibe-coder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite-node tools/reportSize.ts",
    "check:types": "svelte-check --tsconfig tsconfig.json && tsc -p tsconfig.game.json && tsc -p tools/type-fixtures/tsconfig.positive.json",
    "lint": "eslint src tests tools/*.ts tools/art art vite.config.ts vitest.config.ts playwright.config.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run check:types && npm run lint && npm run format:check && npm run test:rules && npm run check:content && npm run check:release-content",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:game": "vitest run --config vitest.config.ts",
    "check:content": "vite-node tools/checkContent.ts && vite-node tools/art/export.ts -- --check",
    "test:browser": "playwright test",
    "art:export": "vite-node tools/art/export.ts",
    "art:check": "vite-node tools/art/export.ts -- --check",
    "check:release-content": "vite-node tools/checkReleaseContent.ts"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "svelte": "^5.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.8",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vite-node": "^3.2.4",
    "vitest": "^3.0.2"
  }
}

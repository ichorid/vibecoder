{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibe-coder/arrangement.schema.json",
  "title": "ArrangementDocument",
  "description": "Which roles sound and with which preset/level. Changes apply at phrase boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "roles"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preset"],
        "properties": {
          "preset": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "level": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

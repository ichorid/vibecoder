{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibe-coder/motif.schema.json",
  "title": "MotifDocument",
  "description": "The shared melodic motif, as scale degrees and rhythm (status is honest: demo/pending/approved).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "status", "degrees", "license"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["demo", "pending", "approved"]
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "degrees": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7
      }
    },
    "rhythmSteps": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16
      }
    },
    "license": {
      "enum": ["CC0-1.0", "CC-BY-4.0"]
    },
    "attribution": {
      "type": "string",
      "maxLength": 300
    }
  }
}
